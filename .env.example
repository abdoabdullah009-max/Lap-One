# ---- Core ----
NODE_ENV=development
PORT=3000
# Public URL used in emails, canonical links, sitemap, payment callbacks
PUBLIC_BASE_URL=http://localhost:3000
# PostgreSQL connection (managed Postgres in production; add ?sslmode=require)
DATABASE_URL=postgres://lapone:CHANGE_ME@127.0.0.1:5432/lapone
# builtin = bundled wire client, pg = official node-postgres driver (npm i pg)
DB_DRIVER=builtin
DB_POOL_MAX=10
# 32+ random characters: openssl rand -hex 32
SESSION_SECRET=
# Set true when running behind a reverse proxy/load balancer (uses X-Forwarded-For for rate limiting)
TRUST_PROXY=false

# ---- Paymob ----
# sandbox_mock = local simulated hosted checkout (no Paymob account needed)
# test         = real Paymob test credentials
# live         = production
PAYMOB_MODE=sandbox_mock
PAYMOB_API_BASE=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
# HMAC secret from Paymob dashboard (Settings → Account Info). Used to verify callbacks.
PAYMOB_HMAC_SECRET=
PAYMOB_CARD_INTEGRATION_ID=
PAYMOB_WALLET_INTEGRATION_ID=

# ---- Uploads ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8

# ---- Seed (first run only) ----
SEED_ADMIN_EMAIL=admin@lapone.local
# Leave empty to generate a random password (printed once by `npm run seed`)
SEED_ADMIN_PASSWORD=
