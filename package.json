{
  "name": "lapone",
  "version": "0.1.0",
  "private": true,
  "description": "LAP ONE — e-commerce platform for inspected imported laptops (Egypt)",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "start": "node dist/server.js",
    "migrate": "node dist/migrate.js",
    "seed": "node dist/seed.js",
    "seed:reset": "node dist/seed.js --reset",
    "typecheck": "tsc --noEmit",
    "test": "node build.mjs && node --test --test-concurrency=1 dist/tests/*.test.js",
    "test:e2e": "node tests/e2e/run.mjs",
    "build:static": "node -e \"import('esbuild').then(e=>e.build({entryPoints:['scripts/build-static.ts'],bundle:true,platform:'node',format:'esm',packages:'external',outfile:'dist/build-static.js'}))\" && node dist/build-static.js"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.76"
  },
  "optionalDependencies": {
    "pg": "^8.13.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.50.0"
  }
}
